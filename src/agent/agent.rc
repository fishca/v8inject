#pragma code_page(65001)
// v8inject-agent: settings dialog. The source is UTF-8; rc.exe otherwise
// reads it in the system ANSI codepage and Cyrillic turns into mojibake.
#include <windows.h>

#define IDD_AGENT 200

IDD_AGENT DIALOGEX 0, 0, 264, 118
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "v8inject-агент — настройки"
FONT 8, "Tahoma", 0, 0, 0
BEGIN
    LTEXT "Имена процессов (через запятую):", -1, 10, 10, 200, 10
    EDITTEXT 101, 10, 22, 244, 14, ES_AUTOHSCROLL
    CONTROL "Показывать GitBar после внедрения", 102, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 10, 46, 200, 12
    CONTROL "Автозапуск с Windows", 103, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 10, 62, 180, 12
    DEFPUSHBUTTON "OK", IDOK, 88, 92, 60, 18
    PUSHBUTTON "Отмена", IDCANCEL, 158, 92, 60, 18
END